# ----------------------------------------------------------------
# General Python Files & Folders to Ignore
# ----------------------------------------------------------------

# Virtual Environment
# Contains installed libraries, created by 'pip install -r requirements.txt'
venv/
.venv/

# Python cache files
# Automatically generated by Python
__pycache__/
*.pyc

# Distribution / packaging
# Created when building a distributable version
/build/
/dist/
*.egg-info/

# ----------------------------------------------------------------
# Project-Specific Files & Folders
# ----------------------------------------------------------------

# Generated medical reports folder
# Contains PDFs generated by the app
/reports/

# IDE specific files
# Folders for editors like VS Code or PyCharm
.vscode/
.idea/
.sixth/

# Environment variables file
# Might contain sensitive keys
.env

# Temporary files created by the OS or other tools
*.swp
*~

# OS-specific files (e.g., macOS)
.DS_Store
Thumbs.db

# Log files
# Contains runtime logs, not needed in the repo
*.log

# VS Code temporary runner files
*tempCodeRunnerFile*

# Pytest cache
# Automatically generated during testing
.pytest_cache/

# User-specific temporary/scratch files
short_structure.txt

# ChromaDB vector store (generated at runtime)
chroma_db/
chroma_db_v2/
chroma_db_backup/

# Evaluation results (generated by scripts/evaluate_rag.py)
evaluation_results.json

# Chainlit generated data (but keep config)
.chainlit/*
!.chainlit/config.toml
.chainlit/translations/

# Skin image datasets (too large for Git)
data/skin_images/

# GPU virtual environment
venv_gpu/

# Log directory
logs/

# Files directory
.files/

# Root archive directory (legacy code, too large for GitHub)
/archive/

# Tunneling tools (not part of the project)
bore/
bore.zip
ngrok_bin/
ngrok.zip

# Empty asset dir (leftover from removed custom CSS)
public/

# Scratch test scripts
test_llm_flow.py
